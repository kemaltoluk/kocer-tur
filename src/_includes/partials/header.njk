<a class="atla-baglantisi" href="#ana">İçeriğe atla</a>

<header class="ust">
  <div class="kap ust__ic">
    <a class="logo" href="/" aria-label="{{ site.ad }} — ana sayfa">
      <span class="logo__isaret" aria-hidden="true">
        <svg viewBox="0 0 40 22" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M1 20C7 9 18 2 39 2" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
          <path d="M4 20.5C10 10 20 4 38 4" stroke="#14161b" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="3 3.5"/>
        </svg>
      </span>
      <span class="logo__yazi">KOÇER<span>TUR</span></span>
    </a>

    <nav aria-label="Ana menü">
      <ul class="menu" id="ana-menu" data-acik="false">
        <li><a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Ana Sayfa</a></li>
        <li><a href="/hizmetler/"{% if '/hizmetler/' in page.url %} aria-current="page"{% endif %}>Hizmetler</a></li>
        <li><a href="/filo/"{% if page.url == '/filo/' %} aria-current="page"{% endif %}>Filomuz</a></li>
        <li><a href="/hakkimizda/"{% if page.url == '/hakkimizda/' %} aria-current="page"{% endif %}>Hakkımızda</a></li>
        <li><a href="/blog/"{% if '/blog/' in page.url %} aria-current="page"{% endif %}>Blog</a></li>
        <li><a href="/iletisim/"{% if page.url == '/iletisim/' %} aria-current="page"{% endif %}>İletişim</a></li>
      </ul>
    </nav>

    <div class="ust__eylem">
      <a class="ust__tel" href="tel:{{ site.telefon | telLink }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
        {{ site.telefon }}
      </a>

      <a class="btn" href="/iletisim/#teklif">Teklif Al</a>

      <button class="menu-dugme" type="button" aria-expanded="false" aria-controls="ana-menu">
        <span></span><span></span><span></span>
        <span class="gizli-metin">Menüyü aç/kapat</span>
      </button>
    </div>
  </div>
</header>
