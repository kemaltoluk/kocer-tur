<footer class="alt">
  <div class="kap alt__ic">
    <div class="alt__marka">
      <span class="logo">
        <span class="logo__isaret" aria-hidden="true">
          <svg viewBox="0 0 40 22" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 20C7 9 18 2 39 2" stroke="currentColor" stroke-width="4.5" stroke-linecap="round"/>
            <path d="M4 20.5C10 10 20 4 38 4" stroke="#14161b" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="3 3.5"/>
          </svg>
        </span>
        <span class="logo__yazi">KOÇER<span>TUR</span></span>
      </span>
      <p style="margin-top:1rem; max-width:32ch;">{{ site.slogan }}</p>
      <p style="margin-top:0.75rem; max-width:36ch;">{{ site.ozet }}</p>
    </div>

    <div>
      <h4>Hizmetlerimiz</h4>
      <ul>
        {%- for h in collections.hizmetler %}
        <li><a href="{{ h.url }}">{{ h.data.baslik }}</a></li>
        {%- endfor %}
      </ul>
    </div>

    <div>
      <h4>Kurumsal</h4>
      <ul>
        <li><a href="/hakkimizda/">Hakkımızda</a></li>
        <li><a href="/filo/">Filomuz</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/iletisim/">İletişim</a></li>
        <li><a href="/iletisim/#teklif">Teklif Al</a></li>
      </ul>
    </div>

    <div>
      <h4>İletişim</h4>
      <a class="alt__telefon" href="tel:{{ site.telefon | telLink }}">{{ site.telefon }}</a>
      <ul style="margin-top:0.75rem;">
        <li>{{ site.yetkili }}</li>
        {%- if "DOLDURULACAK" not in site.eposta %}
        <li><a href="mailto:{{ site.eposta }}">{{ site.eposta }}</a></li>
        {%- endif %}
        <li>
          {%- if "DOLDURULACAK" not in site.adres.sokak %}{{ site.adres.sokak }}<br>{% endif -%}
          {{ site.adres.ilce }} / {{ site.adres.il }}
        </li>
        <li>{{ site.calismaSaatleri }}</li>
      </ul>
    </div>
  </div>

  <div class="kap">
    <div class="alt__son">
      <span>&copy; {% yil %} {{ site.ad }}. Tüm hakları saklıdır.</span>
      <span>{{ site.hizmetKapsami | capitalize }} hizmet · Yoğun bölgeler: {{ site.hizmetBolgeleri | join(", ") }}</span>
    </div>
  </div>
</footer>

<div class="hizli">
  <a class="hizli__wa" href="https://wa.me/{{ site.telefon | waLink }}" target="_blank" rel="noopener" aria-label="WhatsApp'tan yazın">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.79-1.48-1.75-1.65-2.05-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37s-1.04 1.02-1.04 2.48 1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.8h-.03a9.8 9.8 0 0 1-4.98-1.37l-.36-.21-3.7.97.99-3.61-.23-.37a9.79 9.79 0 0 1-1.5-5.23c0-5.41 4.4-9.81 9.82-9.81 2.62 0 5.08 1.02 6.93 2.88a9.74 9.74 0 0 1 2.87 6.94c0 5.41-4.4 9.81-9.81 9.81M20.52 3.45A11.72 11.72 0 0 0 12.05 0C5.5 0 .18 5.33.17 11.87c0 2.09.55 4.13 1.59 5.93L.07 24l6.34-1.66a11.87 11.87 0 0 0 5.64 1.44h.01c6.54 0 11.87-5.33 11.88-11.88a11.8 11.8 0 0 0-3.42-8.45"/></svg>
    <span class="gizli-metin">WhatsApp</span>
  </a>
  <a class="hizli__tel" href="tel:{{ site.telefon | telLink }}" aria-label="Hemen arayın">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
    <span class="gizli-metin">Telefon</span>
  </a>
</div>
